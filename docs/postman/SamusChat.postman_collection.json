{
  "info": {
    "name": "SamusChat - Regressao API Android e Desktop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar apenas em API descartavel H2. Cria contas ficticias, servidor e canais. Inclui CRUD, mensagens privadas, anexos e sinalizacao de chamadas. Nao comprova midia WebRTC real."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18081"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Saude') {",
          "  pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 16));",
          "  pm.collectionVariables.set('callId', pm.variables.replaceIn('{{$guid}}'));",
          "  ['tokenA', 'tokenB', 'serverId', 'textId', 'voiceId', 'messageId', 'desktopPrivateId', 'desktopReplyId', 'desktopUploadPath'].forEach(key => pm.collectionVariables.unset(key));",
          "  const run = pm.collectionVariables.get('runId');",
          "  pm.collectionVariables.set('testClientSuffix', (parseInt(run.slice(0, 2), 16) % 254 + 1) + '.' + (parseInt(run.slice(2, 4), 16) % 254 + 1));",
          "}",
          "pm.request.headers.upsert({key: 'X-Forwarded-For', value: '198.20.' + pm.collectionVariables.get('testClientSuffix')});"
        ]
      }
    }
  ],
  "item": [
