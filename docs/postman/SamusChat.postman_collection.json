{
  "info": {
    "name": "SamusChat - Regressao HTTP e chamadas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar apenas em API descartavel de teste. Cria duas contas e um servidor. GET, POST, PUT e DELETE; sinalizacao de chamada privada e sala. Nao comprova midia WebRTC."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18081"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Saude') {",
          "  pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 16));",
          "  pm.collectionVariables.set('callId', pm.variables.replaceIn('{{$guid}}'));",
          "  ['tokenA', 'tokenB', 'serverId', 'textId', 'voiceId', 'messageId'].forEach(key => pm.collectionVariables.unset(key));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Saude",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
