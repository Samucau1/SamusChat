# Copy to .env.prod on the server; never commit real values.
BACKEND_IMAGE=ghcr.io/samucau1/samuschat-backend
IMAGE_TAG=replace-with-git-commit-sha
DB_USER=samuschat
DB_PASSWORD=replace-with-a-random-database-password
REDIS_PASSWORD=replace-with-a-random-redis-password
JWT_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
PUBLIC_BASE_URL=https://chat.example.com
# Bind locally behind a TLS reverse proxy. Use 0.0.0.0 only for a deliberate HTTP setup.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Optional calls relay. Use your own TURN service and an independent random REST auth secret.
CALLS_STUN_URL=
CALLS_TURN_URL=
CALLS_TURN_SECRET=

# Password recovery / Google: fill locally, never commit secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
AUTH_MAIL_FROM=
GOOGLE_CLIENT_ID=
